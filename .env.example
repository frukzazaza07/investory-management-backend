APP_PORT=8080

# Postgres connection — either set DATABASE_URL (takes priority, e.g. for hosted
# platforms like Render/Railway) or the individual DB_* vars for local/docker-compose.
DATABASE_URL=
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_db_password
DB_NAME=inventory_db
DB_SSLMODE=disable
JWT_SECRET=your_jwt_secret_here
SEED=true
POS_API_KEY=your_pos_api_key_here

# TLS (mkcert — leave empty for plain HTTP)
TLS_CERT=
TLS_KEY=
